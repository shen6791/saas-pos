generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  OWNER
  ADMIN
  CASHIER
}

enum SaleStatus {
  OPEN
  PAID
  VOID
}

model Tenant {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  users     User[]
  products  Product[]
  sales     Sale[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model User {
  id           String   @id @default(cuid())
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String
  name         String
  passwordHash String
  role         UserRole @default(CASHIER)
  sales        Sale[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([tenantId, email])
  @@index([tenantId])
}

model Product {
  id          String     @id @default(cuid())
  tenantId    String
  tenant      Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  sku         String
  name        String
  description String?
  priceCents  Int
  stock       Int        @default(0)
  active      Boolean    @default(true)
  saleItems   SaleItem[]
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@unique([tenantId, sku])
  @@index([tenantId])
}

model Sale {
  id         String     @id @default(cuid())
  tenantId   String
  tenant     Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  cashierId  String
  cashier    User       @relation(fields: [cashierId], references: [id])
  status     SaleStatus @default(PAID)
  subtotalCents Int
  taxCents      Int     @default(0)
  totalCents    Int
  items      SaleItem[]
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  @@index([tenantId])
  @@index([cashierId])
}

model SaleItem {
  id             String  @id @default(cuid())
  saleId         String
  sale           Sale    @relation(fields: [saleId], references: [id], onDelete: Cascade)
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceCents Int
  lineTotalCents Int

  @@index([saleId])
  @@index([productId])
}
